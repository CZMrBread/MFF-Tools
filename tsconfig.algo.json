{
  // Kód vizualizací algoritmů (src/algo/, sloučený z dřívějšího samostatného algo/).
  // DOČASNĚ bez noUncheckedIndexedAccess (s ním ~700 chyb) – dluh, opravy po
  // souborech v kroku G plánu (docs/plan-algo.md, docs/migrace.md). Jinak stejná
  // pravidla jako tsconfig.app.json. Projekt je kompozitní, aby ho tsconfig.app.json
  // mohl importovat (App.tsx → AlgoPage) a přitom kontrolovat svými pravidly.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.algo.tsbuildinfo",
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/algo-types",
    "rootDir": "./src/algo",
    "target": "es2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/algo"]
}
